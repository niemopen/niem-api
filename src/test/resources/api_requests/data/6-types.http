
@steward = niem
@model = model
@version = 5.2
@prefix = nc
@class_qname = nc:PersonType
@datatype_qname = nc:AddressCategoryCodeSimpleType
@datatype_class_qname = nc:AddressCategoryCodeType
@extended_qname = nc:VehicleType
@category = complex_object

@mediaType = mediaType=json
# @mediaType = mediaType=xml

### Get a class type (CCC)
GET {{baseUrl}}/stewards/{{steward}}/models/{{model}}/versions/{{version}}/types/{{class_qname}}?{{mediaType}}

### Get a datatype (simple)
GET {{baseUrl}}/stewards/{{steward}}/models/{{model}}/versions/{{version}}/types/{{datatype_qname}}?{{mediaType}}

### Get a datatype class (CSC)
GET {{baseUrl}}/stewards/{{steward}}/models/{{model}}/versions/{{version}}/types/{{datatype_class_qname}}?{{mediaType}}

### Get a class type with a parent (CCC)
GET {{baseUrl}}/stewards/{{steward}}/models/{{model}}/versions/{{version}}/types/{{extended_qname}}?{{mediaType}}





### Get a class type (CCC) in CMF
GET {{baseUrl}}/stewards/{{steward}}/models/{{model}}/versions/{{version}}/types/{{class_qname}}/formats/cmf?{{mediaType}}

### Get a datatype (simple) in CMF
GET {{baseUrl}}/stewards/{{steward}}/models/{{model}}/versions/{{version}}/types/{{datatype_qname}}/formats/cmf?{{mediaType}}

### Get a datatype class (CSC) in CMF
GET {{baseUrl}}/stewards/{{steward}}/models/{{model}}/versions/{{version}}/types/{{datatype_class_qname}}/formats/cmf?{{mediaType}}

### Get a class type with a parent (CCC) in CMF
GET {{baseUrl}}/stewards/{{steward}}/models/{{model}}/versions/{{version}}/types/{{extended_qname}}/formats/cmf?{{mediaType}}




### Count types in a version
GET {{baseUrl}}/stewards/{{steward}}/models/{{model}}/versions/{{version}}/types/count

### Count types in a version with the given category
GET {{baseUrl}}/stewards/{{steward}}/models/{{model}}/versions/{{version}}/types/count?category={{category}}

### Count types in a namespace
GET {{baseUrl}}/stewards/{{steward}}/models/{{model}}/versions/{{version}}/namespaces/{{prefix}}/types/count

### Count types in a namespace with the given category
GET {{baseUrl}}/stewards/{{steward}}/models/{{model}}/versions/{{version}}/namespaces/{{prefix}}/types/count?category={{category}}



### Get all types in a version (default pagination)
GET {{baseUrl}}/stewards/{{steward}}/models/{{model}}/versions/{{version}}/types

### Get all types in a version (sort by name desc)
GET {{baseUrl}}/stewards/{{steward}}/models/{{model}}/versions/{{version}}/types?sort=prefix,desc&sort=name,desc

### Get all types in a version (sort by prefix desc, name asc, page number, size)
GET {{baseUrl}}/stewards/{{steward}}/models/{{model}}/versions/{{version}}/types?size=5&page=12&sort=prefix,desc&sort=name

### Get all types in a namespace (default pagination)
GET {{baseUrl}}/stewards/{{steward}}/models/{{model}}/versions/{{version}}/namespaces/{{prefix}}/types



### Get previous type
GET {{baseUrl}}/stewards/{{steward}}/models/{{model}}/versions/{{version}}/types/{{datatype_class_qname}}/prev

### Get next type
GET {{baseUrl}}/stewards/{{steward}}/models/{{model}}/versions/{{version}}/types/{{datatype_class_qname}}/next

### Get current type
GET {{baseUrl}}/stewards/{{steward}}/models/{{model}}/versions/3.0/types/{{class_qname}}/current

### Get type history
GET {{baseUrl}}/stewards/{{steward}}/models/{{model}}/versions/{{version}}/types/{{datatype_class_qname}}/history



### Get type inheritance chain
GET {{baseUrl}}/stewards/{{steward}}/models/{{model}}/versions/{{version}}/types/j:CommercialVehicleType/bases

### Get type restriction chain
GET {{baseUrl}}/stewards/{{steward}}/models/{{model}}/versions/{{version}}/types/nc:TextType/bases

### Error checking: Get type inheritance chain for type without a base
GET {{baseUrl}}/stewards/{{steward}}/models/{{model}}/versions/{{version}}/types/nc:PersonType/bases



### Get class type children
GET {{baseUrl}}/stewards/{{steward}}/models/{{model}}/versions/{{version}}/types/nc:ItemType/children

### Get datatype children
GET {{baseUrl}}/stewards/{{steward}}/models/{{model}}/versions/{{version}}/types/xs:date/children

### Error checking: Get type inheritance chain for type without a base
GET {{baseUrl}}/stewards/{{steward}}/models/{{model}}/versions/{{version}}/types/nc:ScheduleType/children



### Get augmentation point
GET {{baseUrl}}/stewards/{{steward}}/models/{{model}}/versions/{{version}}/types/nc:PersonType/augmentation-point

### Get augmentation point - error checking
GET {{baseUrl}}/stewards/{{steward}}/models/{{model}}/versions/{{version}}/types/nc:AddressCategoryCodeType/augmentation-point



### Get augmentations
GET {{baseUrl}}/stewards/{{steward}}/models/{{model}}/versions/{{version}}/types/nc:PersonType/augmentations

### Get augmentations - error checking
GET {{baseUrl}}/stewards/{{steward}}/models/{{model}}/versions/{{version}}/types/nc:AddressCategoryCodeType/augmentations



### Get usages
GET {{baseUrl}}/stewards/{{steward}}/models/{{model}}/versions/{{version}}/types/nc:PersonType/usages

### Get usages
GET {{baseUrl}}/stewards/{{steward}}/models/{{model}}/versions/{{version}}/types/nc:TextType/usages

### Get augmentations - error checking
GET {{baseUrl}}/stewards/{{steward}}/models/{{model}}/versions/{{version}}/types/nc:AddressCategoryCodeSimpleType/usages
