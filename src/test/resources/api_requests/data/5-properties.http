
@steward = niem
@model = model
@version = 5.2
@prefix = nc
@abstract_qname = nc:PersonHairColorAbstract
@substitution_qname = nc:PersonHairColorText
@attribute_qname = nc:personNameCommentText
@object_qname = biom:Biometric
@category = attribute

@properties = properties
# @properties = properties.cmf

### Get an abstract property
GET {{baseUrl}}/stewards/{{steward}}/models/{{model}}/versions/{{version}}/{{properties}}/{{abstract_qname}}

### Get a substitution property
GET {{baseUrl}}/stewards/{{steward}}/models/{{model}}/versions/{{version}}/{{properties}}/{{substitution_qname}}

### Get an attribute property
GET {{baseUrl}}/stewards/{{steward}}/models/{{model}}/versions/{{version}}/{{properties}}/{{attribute_qname}}

### Get an object property
GET {{baseUrl}}/stewards/{{steward}}/models/{{model}}/versions/{{version}}/{{properties}}/{{object_qname}}

### Get an object property in XML
GET {{baseUrl}}/stewards/{{steward}}/models/{{model}}/versions/{{version}}/{{properties}}/{{object_qname}}?mediaType=xml

### Get an object property in CMF XML
GET {{baseUrl}}/stewards/{{steward}}/models/{{model}}/versions/{{version}}/properties.cmf/{{object_qname}}?mediaType=xml

### Get an object property in CMF JSON
GET {{baseUrl}}/stewards/{{steward}}/models/{{model}}/versions/{{version}}/properties.cmf/{{object_qname}}

### Check error handling: Get an property that does not exist
GET {{baseUrl}}/stewards/{{steward}}/models/{{model}}/versions/{{version}}/{{properties}}/nc:Pineapple

### Check error handling: Get a property from a namespace that does not exist
GET {{baseUrl}}/stewards/{{steward}}/models/{{model}}/versions/{{version}}/{{properties}}/my:Person

### Count properties in a version
GET {{baseUrl}}/stewards/{{steward}}/models/{{model}}/versions/{{version}}/properties/count

### Count properties in a version with the given category
GET {{baseUrl}}/stewards/{{steward}}/models/{{model}}/versions/{{version}}/properties/count?category={{category}}

### Count properties in a namespace
GET {{baseUrl}}/stewards/{{steward}}/models/{{model}}/versions/{{version}}/namespaces/{{prefix}}/properties/count

### Count properties in a namespace with the given category
GET {{baseUrl}}/stewards/{{steward}}/models/{{model}}/versions/{{version}}/namespaces/{{prefix}}/properties/count?category={{category}}

### Get all properties in a version (default pagination)
GET {{baseUrl}}/stewards/{{steward}}/models/{{model}}/versions/{{version}}/properties

### Get all properties in a version (sort by name desc)
GET {{baseUrl}}/stewards/{{steward}}/models/{{model}}/versions/{{version}}/properties?sort=prefix,desc&sort=name,desc

### Get all properties in a version (sort by prefix desc, name asc, page number, size)
GET {{baseUrl}}/stewards/{{steward}}/models/{{model}}/versions/{{version}}/properties?size=5&page=12&sort=prefix,desc&sort=name

### Get all properties in a version (sort by namespace rank desc, prefix, name)
GET {{baseUrl}}/stewards/{{steward}}/models/{{model}}/versions/{{version}}/properties?size=5&page=12&sort=namespaceRank,desc&sort=prefix&sort=name

### Get all properties in a namespace (default pagination)
GET {{baseUrl}}/stewards/{{steward}}/models/{{model}}/versions/{{version}}/namespaces/{{prefix}}/properties

### Get previous property
GET {{baseUrl}}/stewards/{{steward}}/models/{{model}}/versions/{{version}}/properties/{{abstract_qname}}/prev

### Get next property
GET {{baseUrl}}/stewards/{{steward}}/models/{{model}}/versions/{{version}}/properties/{{abstract_qname}}/next

### Get property history
GET {{baseUrl}}/stewards/{{steward}}/models/{{model}}/versions/{{version}}/properties/{{abstract_qname}}/history
