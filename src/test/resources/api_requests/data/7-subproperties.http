
@steward = niem
@model = model
@version = 5.2
@prefix = nc
@class_qname = nc:PersonNameType
@child_qname = nc:PersonGivenName


### Get all child properties of a given class
GET {{baseUrl}}/stewards/{{steward}}/models/{{model}}/versions/{{version}}/types/{{class_qname}}/subproperties

### Get a specific child property of a given class
GET {{baseUrl}}/stewards/{{steward}}/models/{{model}}/versions/{{version}}/types/{{class_qname}}/subproperties/{{child_qname}}

### Get all container types for a given property
GET {{baseUrl}}/stewards/{{steward}}/models/{{model}}/versions/{{version}}/properties/{{child_qname}}/subproperties

### Count all subproperties in a version
GET {{baseUrl}}/stewards/{{steward}}/models/{{model}}/versions/{{version}}/subproperties/count

### Count all subproperties in a namespace
GET {{baseUrl}}/stewards/{{steward}}/models/{{model}}/versions/{{version}}/namespaces/{{prefix}}/subproperties/count

### Count all subproperties for a type
GET {{baseUrl}}/stewards/{{steward}}/models/{{model}}/versions/{{version}}/types/{{class_qname}}/subproperties/count

### Count all subproperties in which a given property appears
GET {{baseUrl}}/stewards/{{steward}}/models/{{model}}/versions/{{version}}/properties/{{child_qname}}/subproperties/count

### Get previous subproperty
GET {{baseUrl}}/stewards/{{steward}}/models/{{model}}/versions/{{version}}/types/{{class_qname}}/subproperties/{{child_qname}}/prev

### Get next subproperty
GET {{baseUrl}}/stewards/{{steward}}/models/{{model}}/versions/{{version}}/types/{{class_qname}}/subproperties/{{child_qname}}/next

### Get subproperty history
GET {{baseUrl}}/stewards/{{steward}}/models/{{model}}/versions/{{version}}/types/{{class_qname}}/subproperties/{{child_qname}}/history
