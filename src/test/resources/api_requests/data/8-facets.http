
@steward = niem
@model = model
@version = 5.2
@prefix = nc
@qname = nc:AddressCategoryCodeSimpleType
@property_qname = nc:AddressCategoryCode
@category = enumeration
@value = residential

### Get all facets in a version (paginated)
GET {{baseUrl}}/stewards/{{steward}}/models/{{model}}/versions/{{version}}/facets

### Get all facets in a namespace (paginated)
GET {{baseUrl}}/stewards/{{steward}}/models/{{model}}/versions/{{version}}/namespaces/{{prefix}}/facets

### Get all facets in a type (paginated)
GET {{baseUrl}}/stewards/{{steward}}/models/{{model}}/versions/{{version}}/types/{{qname}}/facets

### Get all facets in a property type (paginated)
GET {{baseUrl}}/stewards/{{steward}}/models/{{model}}/versions/{{version}}/properties/{{property_qname}}/facets

### Get a specific facet in a given type
GET {{baseUrl}}/stewards/{{steward}}/models/{{model}}/versions/{{version}}/types/{{qname}}/facets/{{category}}/{{value}}



### Get all facets in a type in CMF
GET {{baseUrl}}/stewards/{{steward}}/models/{{model}}/versions/{{version}}/types/{{qname}}/facets/formats/cmf



### Count all facets in a version
GET {{baseUrl}}/stewards/{{steward}}/models/{{model}}/versions/{{version}}/facets/count

### Count all facets in a namespace
GET {{baseUrl}}/stewards/{{steward}}/models/{{model}}/versions/{{version}}/namespaces/{{prefix}}/facets/count

### Count all facets in a type
GET {{baseUrl}}/stewards/{{steward}}/models/{{model}}/versions/{{version}}/types/{{qname}}/facets/count

### Count all facets in a property
GET {{baseUrl}}/stewards/{{steward}}/models/{{model}}/versions/{{version}}/properties/{{property_qname}}/facets/count



### Get previous facet
GET {{baseUrl}}/stewards/{{steward}}/models/{{model}}/versions/{{version}}/types/{{qname}}/facets/{{category}}/{{value}}/prev

### Get next facet
GET {{baseUrl}}/stewards/{{steward}}/models/{{model}}/versions/{{version}}/types/{{qname}}/facets/{{category}}/{{value}}/next

### Get current facet
GET {{baseUrl}}/stewards/{{steward}}/models/{{model}}/versions/5.0/types/{{qname}}/facets/{{category}}/{{value}}/current

### Get facet history
GET {{baseUrl}}/stewards/{{steward}}/models/{{model}}/versions/{{version}}/types/{{qname}}/facets/{{category}}/{{value}}/history
