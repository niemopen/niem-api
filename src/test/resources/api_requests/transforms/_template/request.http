
### Transform Request

@url = {{baseUrl}}/transforms/models

# @from = {{format_cmf}}
@from = {{format_xsd}}

@to = {{format_cmf}}
# @to = {{format_xsd}}
# @to = {{format_owl}}
# @to = {{format_json}}

# @filename = CrashDriver.cmf.xml
@filename = niem-core.xsd
# @filename = CrashDriver.zip

@file = ../../../transform/{{filename}}

POST {{url}}
Content-Type: multipart/form-data; boundary={{boundary}}

--{{boundary}}
Content-Disposition: form-data; name="from"

{{from}}
--{{boundary}}
Content-Disposition: form-data; name="to"

{{to}}
--{{boundary}}
Content-Disposition: form-data; name="file"; filename="{{filename}}"
Content-Type: application/xml

< {{file}}
--{{boundary}}--
